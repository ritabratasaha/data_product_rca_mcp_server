      "compiled_code": "with customer_orders as (\n    Select \n    c_name,\n    o_orderkey,\n    o_orderdate,\n    o_totalprice,\n    o_orderstatus,\n    o_orderpriority,\n    o_clerk,\n    o_shippriority,\n    o_comment,\n    c_custkey,\n    c_address,\n    c_nationkey,\n    c_phone,\n    c_acctbal,\n    c_mktsegment,\n    c_comment,\n    l_orderkey,\n    l_partkey,\n    l_suppkey,\n    l_linenumber,\n    l_quantity,\n    l_extendedprice,\n    l_discount,\n    \n    (\n        case \n            -- This runs in the database for every row\n            when c_nationkey = 2 then 0 \n            else l_tax\n        end\n    )\n as l_tax,\n    l_returnflag,\n    l_linestatus,\n    l_shipdate,\n    l_commitdate,\n    l_receiptdate,\n    l_shipinstruct,\n    l_shipmode,\n    l_comment\n    from \n    customer_orders.staging.order_base o \n    left join customer_orders.staging.customer_base c on o.o_custkey = c.c_custkey\n    left join customer_orders.staging.lineitem_base l on o.o_orderkey = l.l_orderkey\n    where date_part(year,o_orderdate) < 1998\n)\nselect * from customer_orders"
    }
