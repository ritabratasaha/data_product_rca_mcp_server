# =============================================================================
# MCP RCA Server Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.template .env
# =============================================================================

# -----------------------------------------------------------------------------
# Testing Mode (for CI/evals only - disables authentication!)
# -----------------------------------------------------------------------------
# TESTING=true

# Testing Snowflake credentials (minimal PUBLIC role user for CI/evals)
# Create user with: docs/setup_snowflake_oauth.sql (see "Testing User Setup" section)
TESTING_SNOWFLAKE_USER=MCP_TESTING_USER
TESTING_SNOWFLAKE_PASSWORD=your_testing_password

# -----------------------------------------------------------------------------
# Snowflake OAuth Configuration (Production)
# -----------------------------------------------------------------------------
SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_OAUTH_CLIENT_ID=your_oauth_client_id
SNOWFLAKE_OAUTH_CLIENT_SECRET=your_oauth_client_secret
SNOWFLAKE_OAUTH_ROLES=PUBLIC

# -----------------------------------------------------------------------------
# Langfuse Observability (Optional)
# -----------------------------------------------------------------------------
# Obtain from https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_HOST=https://cloud.langfuse.com

# -----------------------------------------------------------------------------
# Airflow REST API Connection (Optional)
# -----------------------------------------------------------------------------
AIRFLOW_BASE_URL=http://localhost:8080
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=admin

# -----------------------------------------------------------------------------
# LLM API Keys (for MCP evals only)
# -----------------------------------------------------------------------------

# OpenAI API key
OPENAI_API_KEY=your_openai_api_key
